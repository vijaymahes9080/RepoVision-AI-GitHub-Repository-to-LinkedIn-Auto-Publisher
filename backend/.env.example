# RepoVision backend configuration example.
# Copy to backend/.env and fill in values locally. Never commit real secrets.

APP_NAME=RepoVision AI API
APP_VERSION=0.1.0
APP_ENV=development
API_PREFIX=/api/v1

# SQLite is the local default. Use a PostgreSQL URL in deployments, for example:
# DATABASE_URL=postgresql+psycopg://repovision:change-me@localhost:5432/repovision
DATABASE_URL=sqlite:///./repovision.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional server-side GitHub token. Raises the API rate limit.
# Public repositories work without it. The token is never sent to the browser.
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
GITHUB_TIMEOUT_SECONDS=20

# Snapshot budgets. These bound GitHub reads and analysis cost.
MAX_TREE_ENTRIES=5000
MAX_ANALYZED_FILES=40
MAX_FILE_BYTES=100000
MAX_TOTAL_BYTES=2000000
MAX_README_BYTES=150000

# LLM provider: none | openai | ollama.
# With "none", drafts use the deterministic evidence-linked generator.
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_TIMEOUT_SECONDS=60

# LinkedIn OAuth and publishing (M2). Publishing stays disabled unless LINKEDIN_ENABLED=true
# and all credentials below are present.
#
# Required LinkedIn products: "Sign In with LinkedIn using OpenID Connect" and
# "Share on LinkedIn". The redirect URI must be registered in the LinkedIn app and must
# point at /api/v1/linkedin/oauth/callback on the public HTTPS backend.
LINKEDIN_ENABLED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_API_BASE=https://api.linkedin.com
LINKEDIN_OAUTH_BASE=https://www.linkedin.com/oauth/v2
LINKEDIN_API_VERSION=202501
LINKEDIN_TIMEOUT_SECONDS=30

# Fernet key used to encrypt member access/refresh tokens at rest.
# Generate once, store it in the server secret manager, and never commit it:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Where the OAuth callback redirects the browser after connecting or failing.
FRONTEND_URL=http://localhost:5173
